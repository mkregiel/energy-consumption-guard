---
import AuthLayout from "@/components/auth/AuthLayout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
const returnTo = Astro.url.searchParams.get("returnTo");
---

<AuthLayout title="Zaloguj się">
  <h1
    class="mb-6 bg-gradient-to-r from-blue-200 via-teal-200 to-emerald-200 bg-clip-text text-center text-2xl font-bold text-transparent"
  >
    Zaloguj się
  </h1>
  <SignInForm serverError={error} returnTo={returnTo} client:load />
  <p class="mt-4 text-center text-sm text-blue-100/60">
    Nie masz konta? <a href="/auth/signup" class="text-emerald-300 hover:underline">Zarejestruj się</a>
  </p>
</AuthLayout>
