---
import AuthLayout from "@/components/auth/AuthLayout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<AuthLayout title="Zarejestruj się">
  <h1
    class="mb-6 bg-gradient-to-r from-blue-200 via-teal-200 to-emerald-200 bg-clip-text text-center text-2xl font-bold text-transparent"
  >
    Zarejestruj się
  </h1>
  <SignUpForm serverError={error} client:load />
  <p class="mt-4 text-center text-sm text-blue-100/60">
    Masz już konto? <a href="/auth/signin" class="text-emerald-300 hover:underline">Zaloguj się</a>
  </p>
</AuthLayout>
