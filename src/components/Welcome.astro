---
import Topbar from "@/components/Topbar.astro";
---

<div class="bg-energy relative min-h-screen w-full overflow-hidden">
  <!-- Energy glow -->
  <div
    class="pointer-events-none absolute top-1/3 left-1/2 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-teal-500/10 blur-[160px]"
  >
  </div>

  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 via-teal-200 to-emerald-200 bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl lg:text-7xl"
      >
        Monitor Energii
      </h1>
      <p class="mb-10 max-w-2xl text-lg text-blue-100/70 sm:text-xl">
        Śledź zużycie prądu, ustawiaj limity i otrzymuj powiadomienia e-mail — wszystko w jednym miejscu.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/auth/signin"
          class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-emerald-500"
        >
          Zaloguj się
        </a>
        <a
          href="/auth/signup"
          class="inline-flex items-center justify-center rounded-lg border border-white/20 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-white/10"
        >
          Zarejestruj się
        </a>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-emerald-300"
        >
          <path
            d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"
          ></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-white">Integracja Tuya</h3>
        <p class="text-sm leading-relaxed text-blue-100/60">
          Połącz inteligentny licznik przez platformę Tuya i automatycznie synchronizuj odczyty.
        </p>
      </div>

      <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-emerald-300"
        >
          <path d="m12 14 4-4"></path>
          <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-white">Monitoring zużycia</h3>
        <p class="text-sm leading-relaxed text-blue-100/60">
          Sprawdzaj bieżące i historyczne odczyty zużycia energii w przejrzystym pulpicie.
        </p>
      </div>

      <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-emerald-300"
        >
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-white">Alerty i limity</h3>
        <p class="text-sm leading-relaxed text-blue-100/60">
          Ustaw limity zużycia i otrzymuj powiadomienia e-mail, gdy zbliżasz się do progu.
        </p>
      </div>
    </div>
  </div>
</div>
