---
const { user } = Astro.locals;
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <a href="/" class="font-medium text-white transition-colors hover:text-emerald-200">
          Monitor Energii
        </a>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-emerald-300 transition-colors hover:text-emerald-100 hover:underline">
            Pulpit
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-emerald-300 transition-colors hover:text-emerald-100 hover:underline">
              Wyloguj
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <a href="/" class="font-medium text-white transition-colors hover:text-emerald-200">
          Monitor Energii
        </a>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-emerald-300 transition-colors hover:text-emerald-100 hover:underline">
            Zaloguj się
          </a>
          <a href="/auth/signup" class="text-emerald-300 transition-colors hover:text-emerald-100 hover:underline">
            Zarejestruj się
          </a>
        </div>
      </>
    )
  }
</div>
